# Python environment managed by uv
.venv/
__pycache__/
*.py[cod]

# Test run logs (results of each run, not source artifacts)
outputs/*
!outputs/.gitkeep

# Data with real network topology / IPs of Remote cloud domain and Local cloud domain: source CSVs,
# generated spec, and everything derived from it. Reproducible with the scripts in
# src/ (uv run src/generate_test_spec.py, etc.), no need to version it.
inputs/*
!inputs/.gitkeep
manifests/servers/*
!manifests/servers/.gitkeep
standalone/*
!standalone/.gitkeep

# Editors / OS
.DS_Store
.idea/
.vscode/

# Secrets / sensitive material that should never end up in the repo by mistake
# (certificates/keys used in mTLS tests, kubeconfigs, local credentials)
*.pem
*.key
*.p12
*.pfx
.env
kubeconfig*

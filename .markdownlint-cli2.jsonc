{
  // Table cells and fenced code blocks (repo tree, decision tables) carry
  // domain-specific content that can't be hard-wrapped without breaking
  // their structure or truncating meaning, so MD013 skips them.
  "config": {
    "MD013": {
      "line_length": 100,
      "tables": false,
      "code_blocks": false
    }
  }
}

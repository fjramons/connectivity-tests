# Template used to auto-create connectivity-tests.toml (the generic/default
# config) the first time any script needs it and it's missing. Also a
# starting point for a suite-specific override: copy this to
# connectivity-tests.<suite>.toml and adjust the values for that suite.

# What to do when, within the same CSV row, "Port Number / Range" and "Protocol"
# have the same number of elements (>1):
#   - "one_to_one":     pair by position (443<->https, 8081<->tcp, 8082<->tcp over mTLS)
#   - "cross_product":  generate all port x protocol combinations
port_protocol_pairing = "one_to_one"

# Kubernetes namespace where the generated server test manifests
# (suites/<suite>/outputs/manifests/servers/*.yaml) are meant to be deployed. NOT
# embedded into the manifests themselves -- deploy explicitly with
# `kubectl apply -f <file> -n <namespace>` for clarity. This value is only
# used by src/generate_server_manifests.py to print/document the suggested
# deploy command.
namespace = "default"

# How generate_server_manifests.py requests a specific IP for the generated
# LoadBalancer Services from MetalLB. Current MetalLB releases reject a
# Service that sets BOTH mechanisms at once ("service can not have both
# metallb.io/loadBalancerIPs and svc.Spec.LoadBalancerIP"); older releases
# needed one or the other depending on version. Pick whichever your
# cluster's MetalLB needs (or override per-run with --metallb-ip-mechanism):
#   - "both":       sets both spec.loadBalancerIP and the annotation (legacy
#                   default, kept for existing suites -- may fail on recent
#                   MetalLB, see above)
#   - "annotation": metallb.io/loadBalancerIPs only (MetalLB's current
#                   documented mechanism)
#   - "spec_field": spec.loadBalancerIP only (plain Kubernetes field,
#                   understood by MetalLB and most other LB controllers)
metallb_ip_mechanism = "both"

# Configuration for the probe engine (src/run_probe.py), used only if invoked
# with --config connectivity-tests.<suite>.toml (otherwise it uses these same
# values as an embedded default, so it can keep running standalone).
[probe]
# Wait margin between the two "send()" calls of the ICMP port-unreachable
# detection trick for UDP (see README, section 5, UDP note). Calibrated from
# the RTT measured by "ping" to that same host:
#   margin = clamp(mean_rtt_ms/1000 * udp_icmp_wait_rtt_multiplier,
#                   udp_icmp_wait_default_seconds, udp_icmp_wait_max_seconds)
# If no RTT is available (ping failed), udp_icmp_wait_default_seconds is used.
udp_icmp_wait_default_seconds = 0.5
udp_icmp_wait_max_seconds = 2.0
udp_icmp_wait_rtt_multiplier = 4
